{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checklist.local/contracts/media-round-deletion.schema.json",
  "title": "Guarded media round deletion, command operation and content-free cleanup outcome (CL-446, CL-448\u2013450, CL-516, CL-518, CL-519, CL-521)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "media_round_delete"
        },
        "params": {
          "$ref": "#/$defs/delete"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "media_round_deletion_get"
        },
        "params": {
          "$ref": "#/$defs/read"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    "result": {
      "$ref": "#/$defs/summary"
    },
    "deletion_in_progress": {
      "$ref": "#/$defs/deletingRound"
    },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "command_outcome": {
          "const": "accepted"
        },
        "data": {
          "$ref": "#/$defs/operation"
        },
        "write_admission": {
          "$ref": "#/$defs/writeAdmission"
        }
      },
      "required": [
        "command_id",
        "command_outcome",
        "data"
      ]
    },
    "operation_get": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read the original operation in its project. A retired terminal receipt returns the operation_expired tool error.",
      "properties": {
        "method": {
          "const": "operation_get"
        },
        "params": {
          "$ref": "#/$defs/operationParameters"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    "operation_wait": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "operation_wait"
        },
        "params": {
          "$ref": "#/$defs/waitParameters"
        }
      },
      "required": [
        "method",
        "params"
      ]
    },
    "operation_result": {
      "type": "object",
      "additionalProperties": false,
      "description": "Successful deletion summaries skip in-flight purge retirement. The stored receipt still follows ordinary retention and purge scrubbing.",
      "properties": {
        "data": {
          "$ref": "#/$defs/completedOperation"
        },
        "write_admission": {
          "$ref": "#/$defs/writeAdmission"
        }
      },
      "required": [
        "data"
      ]
    },
    "operation_running": {
      "type": "object",
      "additionalProperties": false,
      "description": "A history pass has started. The round remains readable until the last pass commits.",
      "properties": {
        "data": {
          "allOf": [
            {"$ref": "#/$defs/operation"},
            {
              "properties": {
                "state": {"const": "running"},
                "finished_at": false
              },
              "required": ["started_at"]
            }
          ]
        },
        "write_admission": {
          "$ref": "#/$defs/writeAdmission"
        }
      },
      "required": ["data"]
    },
    "operation_expired": {
      "type": "object",
      "additionalProperties": false,
      "description": "MCP tool error structured content returned when the terminal receipt is missing or retired. A successful media_round_delete skips retirement for its own epoch advance. Its existing receipt can still retire through ordinary retention or removal of an exact reference. The command ID stays reserved.",
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "const": "COMMAND_RESULT_EXPIRED"
            },
            "message": {
              "$ref": "#/$defs/text"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "command_id": {
                  "$ref": "#/$defs/uuid"
                }
              },
              "required": ["command_id"]
            }
          },
          "required": ["code", "message", "details"]
        }
      },
      "required": ["error"]
    },
    "projected_operations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Content-free operation_get data while the round remains after a nonfinal history pass. The last pass expires these outcomes and keeps the original command IDs reserved.",
      "properties": {
        "success": {
          "allOf": [
            {"$ref": "#/$defs/projectedOperation"},
            {
              "properties": {
                "state": {"const": "succeeded"},
                "error": false
              },
              "required": ["result"]
            }
          ]
        },
        "failure": {
          "allOf": [
            {"$ref": "#/$defs/projectedOperation"},
            {
              "properties": {
                "state": {"const": "failed"},
                "result": false
              },
              "required": ["error"]
            }
          ]
        }
      },
      "required": ["success", "failure"]
    },
    "operation_failure": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional current failed-operation example. Its diagnostic requirements do not rewrite historical errors returned by exact-original replay.",
      "properties": {
        "data": {
          "$ref": "#/$defs/failedOperation"
        },
        "write_admission": {
          "$ref": "#/$defs/writeAdmission"
        }
      },
      "required": [
        "data"
      ]
    },
    "operation_successor_refusal": {
      "type": "object",
      "additionalProperties": false,
      "description": "A predecessor deletion refuses while a successor remains. Details identify the successor to delete first.",
      "properties": {
        "data": {
          "allOf": [
            {"$ref": "#/$defs/failedOperation"},
            {
              "properties": {
                "error": {
                  "properties": {
                    "code": {"const": "MEDIA_ROUND_REFERENCED"},
                    "details": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "record_id": {"$ref": "#/$defs/text"},
                        "record_type": {"const": "media_round"}
                      },
                      "required": ["record_id", "record_type"]
                    }
                  },
                  "required": ["details"]
                }
              }
            }
          ]
        },
        "write_admission": {"$ref": "#/$defs/writeAdmission"}
      },
      "required": ["data"]
    },
    "operation_attachment_reference_refusal": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ordinary incoming-reference refusal for an attachment, including a cleanup marker without exact handoff and predecessor capture proof.",
      "properties": {
        "data": {
          "allOf": [
            {"$ref": "#/$defs/failedOperation"},
            {
              "properties": {
                "error": {
                  "properties": {
                    "code": {"const": "MEDIA_ROUND_REFERENCED"},
                    "details": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "record_id": {"$ref": "#/$defs/text"},
                        "record_type": {"const": "attachment"}
                      },
                      "required": ["record_id", "record_type"]
                    }
                  },
                  "required": ["details"]
                }
              }
            }
          ]
        },
        "write_admission": {"$ref": "#/$defs/writeAdmission"}
      },
      "required": ["data"]
    },
    "operation_work_limit": {
      "description": "A failed operation names the exceeded bound for the selected deletion, including a workspace authority, matched reference, or indivisible history bound.",
      "type": "object",
      "additionalProperties": false,
      "description": "Optional failed-operation example for a graph, import or indivisible history bound. Aggregate matched history count and identity bytes can continue across passes.",
      "properties": {
        "data": {
          "allOf": [
            {
              "$ref": "#/$defs/failedOperation"
            },
            {
              "properties": {
                "error": {
                  "properties": {
                    "code": {
                      "const": "CLEANUP_INVENTORY_LIMIT"
                    }
                  }
                }
              }
            }
          ]
        },
        "write_admission": {
          "$ref": "#/$defs/writeAdmission"
        }
      },
      "required": [
        "data"
      ]
    },
    "retained_capture_history": {
      "$ref": "#/$defs/captureHistory"
    }
  },
  "required": [
    "delete",
    "read",
    "result",
    "deletion_in_progress",
    "accepted",
    "operation_get",
    "operation_wait",
    "operation_result"
  ],
  "$defs": {
    "projectedOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {"$ref": "#/$defs/uuid"},
        "command_id": {"$ref": "#/$defs/uuid"},
        "project_id": {"$ref": "#/$defs/text"},
        "method": {"$ref": "#/$defs/text"},
        "state": {"enum": ["succeeded", "failed"]},
        "status_method": {"const": "operation_get"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command_id": {"$ref": "#/$defs/uuid"},
            "data": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"result_redacted": {"const": true}},
              "required": ["result_redacted"]
            }
          },
          "required": ["command_id", "data"]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {"type": "string", "pattern": "^[A-Z0-9_]{1,96}$"},
            "message": {"const": "This operation failed. Its original error details were removed during round deletion."},
            "retryable": {"type": "boolean"},
            "details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "command_id": {"$ref": "#/$defs/uuid"},
                "result_redacted": {"const": true},
                "command_outcome": {"enum": ["unknown", "rejected"]}
              },
              "required": ["command_id", "result_redacted"]
            }
          },
          "required": ["code", "message", "retryable", "details"]
        }
      },
      "required": ["operation_id", "command_id", "method", "state", "created_at", "finished_at", "status_method"]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "delete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "$ref": "#/$defs/text"
        },
        "round_id": {
          "$ref": "#/$defs/text"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "command_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "project_id",
        "round_id",
        "expected_revision",
        "reason",
        "command_id"
      ]
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "$ref": "#/$defs/text"
        },
        "round_id": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "project_id",
        "round_id"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))\\S"
        },
        "representation": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "moved",
            "held",
            "kept"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "required": [
        "representation",
        "status",
        "reason",
        "reasons"
      ]
    },
    "deletingRound": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read-only status after the graph is hidden and before the receipt is published.",
      "properties": {
        "deleted": {"const": false},
        "deletion_state": {"const": "deleting"},
        "project_id": {"$ref": "#/$defs/text"},
        "round_id": {"$ref": "#/$defs/text"},
        "removed_records": {"type": "integer", "minimum": 0},
        "total_records": {"type": "integer", "minimum": 1},
        "expected_revision": {"type": "integer", "minimum": 1}
      },
      "required": ["deleted", "deletion_state", "project_id", "round_id", "removed_records", "total_records", "expected_revision"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Content-free semantic result shared by media_round_delete and media_round_deletion_get. The later read reports current cleanup outcomes.",
      "properties": {
        "deleted": {
          "const": true
        },
        "project_id": {
          "$ref": "#/$defs/text"
        },
        "round_id": {
          "$ref": "#/$defs/text"
        },
        "actor": {
          "$ref": "#/$defs/text"
        },
        "actor_kind": {
          "enum": [
            "agent",
            "owner"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Counts of removed records by registered family, including the round."
        },
        "byte_deletion_receipt_id": {
          "$ref": "#/$defs/text"
        },
        "cleanup_state": {
          "$ref": "#/$defs/text"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "kept_attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keptAttachment"
          },
          "description": "Done/Canceled ticket attachments excluded from the round byte-deletion cohort. Borrowed captures require exact successor handoff membership on its target ticket and capture provenance from the named predecessor. Present even when empty."
        },
        "preparation_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "Measured wall seconds spent preparing this deletion after queue wait and before the record commit. Legacy receipts omit both preparation fields."
        },
        "preparation_timings": {
          "description": "Independent wall-clock phase durations. Reference and history work can overlap.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "graph_seconds": {
              "type": "number",
              "minimum": 0
            },
            "references_seconds": {
              "type": "number",
              "minimum": 0
            },
            "cleanup_seconds": {
              "type": "number",
              "minimum": 0,
              "description": "Byte-plan preparation time. A round with no file descriptors skips the backup index."
            },
            "history_seconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "graph_seconds",
            "references_seconds",
            "cleanup_seconds",
            "history_seconds"
          ]
        }
      },
      "required": [
        "deleted",
        "project_id",
        "round_id",
        "actor",
        "actor_kind",
        "reason",
        "counts",
        "byte_deletion_receipt_id",
        "cleanup_state",
        "files",
        "kept_attachments"
      ],
      "dependentRequired": {
        "preparation_seconds": [
          "preparation_timings"
        ],
        "preparation_timings": [
          "preparation_seconds"
        ]
      }
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "minLength": 1,
      "maxLength": 100
    },
    "operationParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "$ref": "#/$defs/text"
        },
        "operation_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "project_id",
        "operation_id"
      ]
    },
    "waitParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "$ref": "#/$defs/text"
        },
        "operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "wait_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 45
        }
      },
      "required": [
        "project_id",
        "operation_id"
      ]
    },
    "completedOperation": {
      "allOf": [
        {
          "$ref": "#/$defs/operation"
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "succeeded"
            }
          },
          "required": [
            "finished_at",
            "result"
          ]
        }
      ]
    },
    "failedOperation": {
      "allOf": [
        {
          "$ref": "#/$defs/operation"
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "failed"
            },
            "error": {
              "$ref": "#/$defs/diagnosticOperationError"
            }
          },
          "required": [
            "finished_at",
            "error"
          ]
        }
      ]
    },
    "diagnosticOperationError": {
      "allOf": [
        {
          "$ref": "#/$defs/operationError"
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "MEDIA_CONTEXT_CHANGED"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "$ref": "#/$defs/deletionContextChangedDetails"
              }
            },
            "required": [
              "details"
            ]
          }
        }
      ]
    },
    "deletionContextChangedDetails": {
      "type": "object",
      "additionalProperties": false,
      "description": "Content-free refusal identity. The check name is an extensible nonblank string. Record IDs can name an infrastructure observation, such as metadata data_version or a temporary journal ID. No payload, path, title or body is returned. Timings are present together after preparation completes; earlier failures omit both.",
      "properties": {
        "check": {
          "$ref": "#/$defs/text"
        },
        "record_type": {
          "$ref": "#/$defs/text"
        },
        "record_id": {
          "$ref": "#/$defs/text"
        },
        "preparation_seconds": {
          "$ref": "#/$defs/summary/properties/preparation_seconds"
        },
        "preparation_timings": {
          "$ref": "#/$defs/summary/properties/preparation_timings"
        }
      },
      "required": [
        "check",
        "record_type",
        "record_id"
      ],
      "dependentRequired": {
        "preparation_seconds": [
          "preparation_timings"
        ],
        "preparation_timings": [
          "preparation_seconds"
        ]
      }
    },
    "keptAttachment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attachment_id": {
          "$ref": "#/$defs/text"
        },
        "task_id": {
          "$ref": "#/$defs/text"
        },
        "task_key": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "const": "kept"
        },
        "reason": {
          "const": "kept_with_ticket"
        }
      },
      "required": [
        "attachment_id",
        "task_id",
        "task_key",
        "status",
        "reason"
      ]
    },
    "captureHistory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": 1
        },
        "state": {
          "const": "round_deleted"
        },
        "round_id": {
          "$ref": "#/$defs/text"
        },
        "owner_id": {
          "$ref": "#/$defs/text"
        },
        "owner_kind": {
          "enum": [
            "media_intake",
            "media_draft_item",
            "media_target"
          ]
        },
        "import_job_id": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "format",
        "state",
        "round_id"
      ],
      "description": "Optional attachment.media_capture_history after round deletion. Historical IDs preserve provenance and resolve no current dependency; active ownership/import-job pointers to removed records are detached. state=round_deleted retains originals and previews through ordinary archive and Done-evidence cleanup until task_purge admits verified Trash disposal under its current guards.",
      "dependentRequired": {
        "owner_id": [
          "owner_kind"
        ],
        "owner_kind": [
          "owner_id"
        ]
      }
    },
    "finalReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "data": {
          "$ref": "#/$defs/summary"
        },
        "write_admission": {
          "$ref": "#/$defs/writeAdmission"
        }
      },
      "required": [
        "command_id",
        "data"
      ]
    },
    "operationError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/text"
        },
        "message": {
          "$ref": "#/$defs/text"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        },
        "correlation_id": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/text"
        },
        "method": {
          "const": "media_round_delete"
        },
        "state": {
          "description": "Queued deletions wait for earlier deletions in their project, including a head deferred by backup write admission. At most two project heads run concurrently. The oldest eligible project head starts when capacity opens.",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "status_method": {
          "const": "operation_get"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "First execution start after queue wait for project order, service capacity and backup admission. Subtract created_at to estimate the initial wait at timestamp precision."
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "waiting_reason": {
          "const": "media_import_recovery",
          "description": "The continued deletion waits for owned import recovery before its final pass."
        },
        "result": {
          "$ref": "#/$defs/finalReply"
        },
        "error": {
          "$ref": "#/$defs/operationError"
        }
      },
      "required": [
        "operation_id",
        "command_id",
        "method",
        "state",
        "created_at",
        "status_method"
      ],
      "description": "The first acknowledgment is queued. Exact-original replay identifies the same operation and may include its first terminal result or error; pending work has neither.",
      "allOf": [
        {
