{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_manifest_id": {
      "type": "string",
      "format": "uuid"
    },
    "acceptance": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/requirementAssessment"
      }
    },
    "project_requirements": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/requirementAssessment"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "instruction_coverage": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/instructionCoverage"
      }
    },
    "all_applicable_project_requirements_assessed": {
      "const": true
    },
    "additional_requirements": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/additionalRequirement"
      }
    }
  },
  "required": [
    "contract_sha256",
    "target_manifest_id",
    "acceptance",
    "project_requirements",
    "evidence_refs",
    "instruction_coverage",
    "all_applicable_project_requirements_assessed",
    "additional_requirements"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Checklist attributed agent review assessment v1",
  "description": "Reviewer judgment and chosen hashed evidence for an exact target/current contract. Shape grants no review authority, creates no native reviewer and proves no external test ran.",
  "$defs": {
    "evidenceRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "type": "string",
              "format": "uuid"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "artifact_id",
            "sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_capture_id": {
              "type": "string",
              "format": "uuid"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "source_capture_id",
            "sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decision_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "decision_sha256"
          ]
        }
      ]
    },
    "requirementAssessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not_applicable"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      },
      "required": [
        "requirement_id",
        "result",
        "rationale",
        "evidence_refs"
      ]
    },
    "instructionCoverage": {
      "description": "An exact review_contract instruction reference. Internal symlinks retain the alias path, ordered link identities and resolved content path/hash. The service matches every field to the immutable capture.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_capture_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of the resolved captured regular instruction file content."
            }
          },
          "required": [
            "source_capture_id",
            "source_sha256",
            "path",
            "sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_capture_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of the resolved captured regular instruction file content."
            },
            "resolved_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "link_chain": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "target",
                  "sha256"
                ]
              }
            }
          },
          "required": [
            "source_capture_id",
            "source_sha256",
            "path",
            "sha256",
            "resolved_path",
            "link_chain"
          ]
        }
      ]
    },
    "additionalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not_applicable"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      },
      "required": [
        "requirement",
        "source",
        "result",
        "rationale",
        "evidence_refs"
      ]
    }
  }
}
