{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ticket-bulk-undo",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "task_id",
          "expected_revision"
        ],
        "additionalProperties": false
      }
    },
    "preview": {
      "type": "boolean",
      "default": true
    },
    "original_command_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "required": [
    "project_id",
    "command_id",
    "tasks",
    "original_command_id"
  ],
  "additionalProperties": false
}
