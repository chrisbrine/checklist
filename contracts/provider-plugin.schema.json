{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bundled provider plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_version",
    "plugin_id",
    "version",
    "provider_id",
    "display_name",
    "capabilities",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "interface_version": {
      "const": 1
    },
    "plugin_id": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "version": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provider_id": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "work_session",
          "pickup",
          "correlated_reply",
          "native_peer",
          "registry_closure",
          "composer",
          "assistant_relay",
          "answer_notice",
          "model_selection"
        ]
      }
    },
    "models": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "selectable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "selectable": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "work_session"
            }
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "allOf": [
              {
                "contains": {
                  "const": "pickup"
                }
              },
              {
                "contains": {
                  "const": "correlated_reply"
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "native_peer"
            }
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "allOf": [
              {
                "contains": {
                  "const": "correlated_reply"
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "registry_closure"
            }
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "allOf": [
              {
                "contains": {
                  "const": "work_session"
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "models": {
            "contains": {
              "properties": {
                "selectable": {
                  "const": true
                }
              },
              "required": [
                "selectable"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "model_selection"
            }
          }
        }
      }
    }
  ]
}
