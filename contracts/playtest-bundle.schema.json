{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Playtest bundle submission input",
  "description": "Optional evidence_manifest.playtest_bundle on a Playtest ticket. The service mints id/version/sha256, adds all files to artifact_refs and validates managed exact originals. Distinct role files, at most 100 in total; new builds require new run attachments. This shape is a submission input, not the stored bundle.",
  "type": "object",
  "properties": {
    "build": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "build_id",
        "version",
        "platform"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "$ref": "#/$defs/file"
    },
    "state_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "screenshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "log": {
      "$ref": "#/$defs/file"
    }
  },
  "required": [
    "build",
    "scenario",
    "state_files",
    "screenshots",
    "log"
  ],
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
