{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ticket-bulk-edit",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "task_id",
          "expected_revision"
        ],
        "additionalProperties": false
      }
    },
    "preview": {
      "type": "boolean",
      "default": true
    },
    "changes": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "status"
            },
            "action": {
              "enum": [
                "queue",
                "defer",
                "block",
                "cancel",
                "reopen"
              ]
            },
            "reason": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "kind",
            "action"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "action": {
                    "enum": [
                      "cancel",
                      "reopen"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "tags"
            },
            "add": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "maxItems": 200,
              "uniqueItems": true
            },
            "remove": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "maxItems": 200,
              "uniqueItems": true
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "assignee"
            },
            "planned_assignee": {
              "oneOf": [
                {
                  "enum": [
                    "human",
                    "unassigned"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "human",
                        "unassigned",
                        "agent"
                      ]
                    },
                    "provider": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    },
                    "session_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "assignment_reason": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "kind",
            "planned_assignee"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "epic"
            },
            "epic_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4000
            }
          },
          "required": [
            "kind",
            "epic_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "triage"
            },
            "triage_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "action": {
              "enum": [
                "add",
                "remove"
              ]
            }
          },
          "required": [
            "kind",
            "triage_id",
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "archive"
            },
            "action": {
              "enum": [
                "archive",
                "unarchive",
                "trash",
                "restore"
              ]
            }
          },
          "required": [
            "kind",
            "action"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "project_id",
    "command_id",
    "tasks",
    "changes"
  ],
  "additionalProperties": false
}
